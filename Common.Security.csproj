<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Common.Security</PackageId>
    <Version>1.0.0</Version>
    <Authors>Fitzroy Wright</Authors>
    <Company>Thinking Machines</Company>
    <Description>Provider-neutral authentication, authorization, and security contracts for Common applications.</Description>
    <RepositoryUrl>https://github.com/fitzroywright/Common.Security</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Common.Security.UnitTests/**/*.cs" />
    <EmbeddedResource Remove="Common.Security.UnitTests/**" />
    <None Remove="Common.Security.UnitTests/**" />
    <Compile Remove="Common.Security.Plugin.ActiveDirectory/**/*.cs" />
    <EmbeddedResource Remove="Common.Security.Plugin.ActiveDirectory/**" />
    <None Remove="Common.Security.Plugin.ActiveDirectory/**" />
    <Compile Remove="Common.Diagnostics/**/*.cs" />
    <EmbeddedResource Remove="Common.Diagnostics/**" />
    <None Remove="Common.Diagnostics/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Common.Diagnostics/Common.Diagnostics.csproj')">
    <ProjectReference Include="Common.Diagnostics/Common.Diagnostics.csproj" AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('Common.Diagnostics/Common.Diagnostics.csproj') And Exists('../Common.Diagnostics/Common.Diagnostics.csproj')">
    <ProjectReference Include="../Common.Diagnostics/Common.Diagnostics.csproj" AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>
</Project>
