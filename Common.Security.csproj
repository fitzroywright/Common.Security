<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Common.Security</PackageId>
    <Version>2.0.0</Version>
    <Authors>Fitzroy Wright</Authors>
    <Company>Thinking Machines</Company>
    <Description>Provider-neutral authentication, authorization, and security contracts for Common applications.</Description>
    <RepositoryUrl>https://github.com/fitzroywright/Common.Security</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Common.Security.Tools/**/*.cs" />
    <Compile Remove="Common.Security.Hosting/**/*.cs" />
    <EmbeddedResource Remove="Common.Security.Hosting/**" />
    <None Remove="Common.Security.Hosting/**" />
    <Compile Remove="Common.Security.UnitTests/**/*.cs" />
    <EmbeddedResource Remove="Common.Security.UnitTests/**" />
    <None Remove="Common.Security.UnitTests/**" />
    <Compile Remove="Common.Security.Plugin.ActiveDirectory/**/*.cs" />
    <EmbeddedResource Remove="Common.Security.Plugin.ActiveDirectory/**" />
    <None Remove="Common.Security.Plugin.ActiveDirectory/**" />
    <Compile Remove="Common.Diagnostics/**/*.cs" />
    <EmbeddedResource Remove="Common.Diagnostics/**" />
    <None Remove="Common.Diagnostics/**" />
  </ItemGroup>
  <PropertyGroup>
    <CommonDiagnosticsProject Condition="'$(CommonDiagnosticsProject)' == '' and Exists('Common.Diagnostics/Common.Diagnostics.csproj')">Common.Diagnostics/Common.Diagnostics.csproj</CommonDiagnosticsProject>
    <CommonDiagnosticsProject Condition="'$(CommonDiagnosticsProject)' == '' and Exists('../Common.Diagnostics/Common.Diagnostics.csproj')">../Common.Diagnostics/Common.Diagnostics.csproj</CommonDiagnosticsProject>
    <CommonDiagnosticsProject Condition="'$(CommonDiagnosticsProject)' == '' and Exists('../Common/Common.Diagnostics/Common.Diagnostics.csproj')">../Common/Common.Diagnostics/Common.Diagnostics.csproj</CommonDiagnosticsProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(CommonDiagnosticsProject)' != ''">
    <ProjectReference Include="$(CommonDiagnosticsProject)" AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>
  <Target Name="RequireCommonDiagnostics" BeforeTargets="PrepareForBuild" Condition="'$(CommonDiagnosticsProject)' == '' or !Exists('$(CommonDiagnosticsProject)')">
    <Error Text="Common.Diagnostics project was not found. Set CommonDiagnosticsProject to the existing Common.Diagnostics.csproj path." />
  </Target>
</Project>